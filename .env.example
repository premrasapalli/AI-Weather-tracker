# Copy this file to .env and fill in optional values.
# The app is fully functional with zero API keys out of the box.

SECRET_KEY=change-me

# --- Debug / runtime ---
DEBUG=false
LOG_LEVEL=INFO
PORT=8080

# --- Open-Meteo (free) endpoints ---
# GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
# FORECAST_URL=https://api.open-meteo.com/v1/forecast
# AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# --- HTTP / cache tuning ---
HTTP_TIMEOUT=10
HTTP_RETRIES=2
HTTP_BACKOFF=0.4
CACHE_TTL_SECONDS=300
CACHE_MAXSIZE=256

# --- India-first behaviour ---
INDIA_ONLY=true
DEFAULT_CITY=Delhi
FEATURED_CITIES=Delhi,Mumbai,Bengaluru,Hyderabad,Chennai,Kolkata,Pune,Jaipur,Ahmedabad,Lucknow,Chandigarh,Surat,Kochi

# --- Optional AI / LLM (skip to run the built-in AI engine) ---
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=15